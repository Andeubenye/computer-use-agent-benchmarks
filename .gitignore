# Keep credentials, accounts and runtime state outside publication.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.sock
node_modules/
.venv/
__pycache__/
*.pyc
.DS_Store
browser-profile*/
user-data*/

# Sensitive filenames; the desktop subfolder allowlists reviewed status-only artifacts.
*credential*
*secret*

# Explicitly reviewed redacted request and value-free safety report.
!browser-benchmarks/evidence/original-github/agents/sai/request-without-credentials.json
!verification/exact-secret-scan.json
