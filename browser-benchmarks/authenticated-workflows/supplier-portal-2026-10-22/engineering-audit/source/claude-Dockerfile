FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.5.3 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xdotool xclip openbox firefox-esr scrot ca-certificates fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN uv pip install --system --no-cache pillow==11.3.0 \
    && useradd --create-home --uid 1000 agent
COPY desktop/ /opt/desktop/
RUN chmod 755 /opt/desktop/start.sh
USER agent
ENV DISPLAY=:1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /home/agent
ENTRYPOINT ["/opt/desktop/start.sh"]
